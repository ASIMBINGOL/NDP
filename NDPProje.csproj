
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <!-- Windows Forms dosyalarini ana projenin derlemesinden cikar -->
  <ItemGroup>
    <Compile Remove="NDP_Proje_Uygulama\**\*.cs" />
    <EmbeddedResource Remove="NDP_Proje_Uygulama\**\*" />
    <None Remove="NDP_Proje_Uygulama\**\*" />
  </ItemGroup>

</Project>
